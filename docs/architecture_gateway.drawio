<mxfile><diagram name="Architecture" id="a1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1230"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Passerelle API sécurisée — ERP universitaire EDU (Spring Cloud Gateway + 5 microservices .NET 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3c5d;strokeColor=#0b3c5d;fontSize=20;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1620" height="55" as="geometry"/></mxCell><mxCell id="z1" value="Zone 1 : TLS (un seul sens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fbf4;strokeColor=#2e8b57;fontSize=15;dashed=1;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="980" height="650" as="geometry"/></mxCell><mxCell id="client" value="1. CLIENT (externe)&lt;br&gt;Navigateur / script&lt;br&gt;Valide uniquement le&lt;br&gt;certificat de la Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a6fb0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="210" height="130" as="geometry"/></mxCell><mxCell id="gw" value="2. SPRING CLOUD GATEWAY — port 8443 (WebFlux)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3efff;strokeColor=#6a4fb3;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="660" height="615" as="geometry"/></mxCell><mxCell id="f1" value="① Terminaison TLS&lt;br&gt;Client → Gateway (HTTPS, TLS 1.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="155" width="620" height="66" as="geometry"/></mxCell><mxCell id="f2" value="② JwtAuthenticationFilter&lt;br&gt;WebFilter global — valide le JWT (HS256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="235" width="620" height="66" as="geometry"/></mxCell><mxCell id="f3" value="③ RoleAuthorizationFilter&lt;br&gt;RBAC — fail-closed (403 si chemin non mappé)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="315" width="620" height="66" as="geometry"/></mxCell><mxCell id="f4" value="④ HmacSigningFilter&lt;br&gt;HMAC-SHA256 sur METHOD · PATH · TIMESTAMP · NONCE · SHA256(BODY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="395" width="620" height="66" as="geometry"/></mxCell><mxCell id="f5" value="⑤ RequestRateLimiter&lt;br&gt;Token bucket Redis — 10/s, burst 20 (X-Client-Id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="475" width="620" height="66" as="geometry"/></mxCell><mxCell id="f6" value="⑥ RoutingLogFilter&lt;br&gt;Journalisation des requêtes routées" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="555" width="620" height="66" as="geometry"/></mxCell><mxCell id="f7" value="⑦ Client mTLS (GatewaySslConfig)&lt;br&gt;La Gateway présente gateway.p12 en sortie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="635" width="620" height="66" as="geometry"/></mxCell><mxCell id="pki" value="PKI privée / Root CA&lt;br&gt;SecureGatewayRootCA (RSA-4096)&lt;br&gt;Certificats par service (CN + SAN)&lt;br&gt;Keystores PKCS12 + truststore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="320" height="170" as="geometry"/></mxCell><mxCell id="redis" value="Redis (conteneur redis-gateway)&lt;br&gt;• Buckets du rate limiter&lt;br&gt;• Déduplication des nonces&lt;br&gt;  (SETNX, TTL 5 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="320" width="320" height="170" as="geometry"/></mxCell><mxCell id="sec" value="Gestion des secrets&lt;br&gt;Variables d'environnement&lt;br&gt;Politique fail-closed :&lt;br&gt;aucun secret par défaut,&lt;br&gt;échec au démarrage si absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="530" width="320" height="170" as="geometry"/></mxCell><mxCell id="obs" value="5. Outils d'audit&lt;br&gt;de validation&lt;br&gt;&lt;br&gt;Trivy&lt;br&gt;(scan dépendances&lt;br&gt;et images)&lt;br&gt;&lt;br&gt;OWASP ZAP&lt;br&gt;(scan dynamique,&lt;br&gt;3 campagnes)&lt;br&gt;&lt;br&gt;Apache JMeter&lt;br&gt;(tests de charge,&lt;br&gt;SLA 1,3 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="260" height="590" as="geometry"/></mxCell><mxCell id="band" value="Zone 2 : mTLS (bidirectionnel) — validation mutuelle des certificats Gateway ↔ chaque backend (CustomRootTrust, TLS 1.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2a6fb0;fontSize=15;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1630" height="60" as="geometry"/></mxCell><mxCell id="b1" value="Finance.Api&lt;br&gt;:5104 — REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="300" height="90" as="geometry"/></mxCell><mxCell id="b2" value="Etudiants.Api&lt;br&gt;:5101 — REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="880" width="300" height="90" as="geometry"/></mxCell><mxCell id="b3" value="Transport.Api&lt;br&gt;:5102 — REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="880" width="300" height="90" as="geometry"/></mxCell><mxCell id="b4" value="Academique.Api&lt;br&gt;:5103 — REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="880" width="300" height="90" as="geometry"/></mxCell><mxCell id="b5" value="RhPaie.Api&lt;br&gt;:5105 — SOAP (SoapCore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="880" width="300" height="90" as="geometry"/></mxCell><mxCell id="def" value="Défense en profondeur côté backend (identique sur les 5 services)&lt;br&gt;① mTLS serveur (Kestrel, RequireCertificate)  ② JWT (JwtBearer / JwtSecurityTokenHandler pour RhPaie)  ③ Rôle ([Authorize(Roles)])&lt;br&gt;④ Re-vérification HMAC  ⑤ Fraîcheur du timestamp ±5 min  ⑥ Anti-rejeu : nonce Redis (nonce:finance:, nonce:etudiants:, …)  ⑦ Logique métier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#555555;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="1630" height="120" as="geometry"/></mxCell><mxCell id="legend" value="Légende : vert = zone TLS 1 sens · pointillé bleu = mTLS · violet = JWT · orange = RBAC · vert clair = HMAC · rouge = rate limit / Redis&lt;br&gt;Référence : rapport de stage Secure API Gateway — I. Akouttif, ENSA Agadir / NetWaciila, 2025-2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="1630" height="70" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS / TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="client" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="gw" target="band"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="band" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="band" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="band" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="band" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="band" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="certificats" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="pki" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="rate limit + nonces" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;startArrow=block;" edge="1" parent="1" source="redis" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="JWT_SECRET / HMAC_SECRET" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;" edge="1" parent="1" source="sec" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>